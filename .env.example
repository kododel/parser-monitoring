# Токен Telegram-бота для уведомлений (получить у @BotFather).
# Можно оставить пустым: сбор и выгрузка в Excel работают и без него.
TELEGRAM_TOKEN=

# Кому отправлять уведомления: id чатов через запятую.
# Свой id можно узнать у бота @userinfobot. Для группы id отрицательный.
TELEGRAM_CHAT_IDS=

# Пути (можно не менять)
DB_PATH=data/prices.db
EXPORT_DIR=data/exports
SITES_FILE=config/sites.json

# Сеть
REQUEST_TIMEOUT=20

# Представляемся сайту честно: с контактом, чтобы админ мог связаться,
# если наш обход ему мешает.
USER_AGENT=PriceMonitorBot/1.0 (+https://t.me/your_username)
